# Local Docker Compose settings. Copy to .env, which is ignored by Git.
# Generate once: python3 -c "import secrets; print(secrets.token_hex(32))"
# Keep this value stable across container replacement.
ISOJAM_JWT_SECRET_KEY=

# The web port is bound to 127.0.0.1 only.
ISOJAM_PORT=8000

# Open explicitly for initial local account creation; closed/invite also work.
ISOJAM_REGISTRATION_MODE=open
ISOJAM_MAX_UPLOAD_BYTES=209715200
ISOJAM_MAX_CONVERTED_AUDIO_BYTES=268435456
ISOJAM_MAX_AUDIO_DURATION_SECONDS=600
ISOJAM_MAX_UNFINISHED_JOBS_PER_USER=2
ISOJAM_MAX_UNFINISHED_IMPORTS_PER_USER=1
ISOJAM_MAX_UNFINISHED_IMPORTS=8
