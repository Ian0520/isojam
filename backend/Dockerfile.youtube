FROM python:3.12.14-slim-bookworm@sha256:392307d22300de8b5986851a12d9176dfc0fc073e65bf6523ebd7dcbeb23564e

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /opt/isojam

RUN apt-get update \
    && apt-get install --no-install-recommends -y ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-api.txt requirements-youtube.txt ./
RUN python -m pip install pip==26.2.1 \
    && python -m pip install --require-hashes --only-binary=:all: -r requirements-api.txt \
    && python -m pip install --require-hashes --only-binary=:all: -r requirements-youtube.txt \
    && python -m pip check \
    && python -c "import yt_dlp, yt_dlp_ejs" \
    && deno --version

COPY pyproject.toml ./
COPY app/ ./app/
RUN python -m pip install --no-deps --no-build-isolation .

RUN groupadd --gid 10001 isojam \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin isojam \
    && mkdir -p /var/lib/isojam/audio/imports \
    && chown -R 10001:10001 /var/lib/isojam

USER 10001:10001
CMD ["python", "-m", "app.youtube", "--help"]
