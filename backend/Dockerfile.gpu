FROM python:3.12.14-slim-bookworm@sha256:392307d22300de8b5986851a12d9176dfc0fc073e65bf6523ebd7dcbeb23564e

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    ISOJAM_PROCESSING_MODE=queued \
    ISOJAM_DATABASE_PATH=/var/lib/isojam/metadata/isojam.db \
    ISOJAM_AUDIO_STORAGE_DIR=/var/lib/isojam/audio \
    BS_ROFORMER_MODELS_PATH=/var/cache/isojam/models \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

WORKDIR /opt/isojam

# PyTorch wheels supply CUDA/OpenMP libraries; the host supplies the driver.
COPY requirements-api.txt requirements-gpu.txt requirements-gpu-build.txt ./
RUN python -m pip install pip==26.2.1 \
    && python -m pip install --require-hashes --only-binary=:all: -r requirements-api.txt \
    && python -m pip install --require-hashes --only-binary=:all: -r requirements-gpu-build.txt \
    && python -m pip install --require-hashes --no-build-isolation --only-binary=:all: -r requirements-gpu.txt

COPY pyproject.toml ./
COPY app/ ./app/
RUN python -m pip install --no-deps --no-build-isolation . \
    && python -m pip check

RUN groupadd --gid 10001 isojam \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin isojam \
    && mkdir -p /var/lib/isojam/metadata /var/lib/isojam/audio /var/cache/isojam/models \
    && chown -R 10001:10001 /var/lib/isojam /var/cache/isojam

USER 10001:10001
CMD ["python", "-m", "app.processor", "serve"]
