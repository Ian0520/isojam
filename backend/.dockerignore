# Only send files needed to build the API and GPU processor images.
*
!Dockerfile
!Dockerfile.gpu
!.dockerignore
!requirements-api.txt
!requirements-gpu.txt
!requirements-gpu-build.txt
!pyproject.toml
!app/
!app/**
!alembic.ini
!migrations/
!migrations/**

# Also exclude generated/private files inside the permitted source directories.
**/__pycache__/
**/*.py[cod]
**/.env
**/.env.*
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.wav
