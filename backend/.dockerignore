# Only send files needed to build runtime images.
*
!Dockerfile
!Dockerfile.gpu
!Dockerfile.youtube
!.dockerignore
!requirements-api.txt
!requirements-gpu.txt
!requirements-gpu-build.txt
!requirements-youtube.txt
!pyproject.toml
!app/
!app/**
!alembic.ini
!migrations/
!migrations/**

# Also exclude generated/private files inside the permitted source directories.
**/__pycache__/
**/*.py[cod]
**/.env
**/.env.*
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.wav
