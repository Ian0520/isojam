  "cards": [
    {
      "dot": "cyan",
      "title": "Primary and unique keys",
      "items": [
        "PK columns may form one composite key; each column need not be unique alone.",
        "job_submission_receipts：PK(user_id, key)。",
        "job_outputs：PK(job_id, stem)。",
        "audio_imports：UK(user_id, submission_key)。",
        "job_attempts: UK(job_id, attempt_number), plus UK(invocation_id)."
      ]
    },
    {
      "dot": "emerald",
      "title": "Reading relationships",
      "items": [
        "Each relationship runs from the child holding the FK to the referenced parent.",
        "Parents may have zero child rows; audio_imports.upload_id is nullable.",
        "Neither audio_imports.upload_id nor job_submission_receipts.job_id is unique.",
        "Invitation emails are bound by application logic, without a users foreign key."
      ]
    },
    {
      "dot": "amber",
      "title": "Types and application rules",
      "items": [
        "Types use the SQLite dialect of the current SQLAlchemy models.",
        "Only columns marked NULL are nullable; UUIDs are stored as CHAR(32).",
        "UK marks members of a unique constraint; subtitles and key notes define each group.",
        "The application verifies all seven tracks; the database has no exactly-seven-rows constraint."
      ]
    }
