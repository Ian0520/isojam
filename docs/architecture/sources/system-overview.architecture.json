  "cards": [
    {
      "dot": "cyan",
      "title": "Durable work",
      "items": [
        "The API commits a job and receipt; the dispatcher discovers queued work in SQLite.",
        "The API and processor share local SQLite and files; no remote GPU RPC is used.",
        "One inference runs at a time; other accepted jobs remain queued."
      ]
    },
    {
      "dot": "emerald",
      "title": "Completion requirements",
      "items": [
        "The processor contains a CPU dispatcher and a GPU child process per job.",
        "Execution needs a grant. Publication requires confirmed exit and all seven valid tracks.",
        "Saved results can recover from a publication failure without repeating inference."
      ]
    },
    {
      "dot": "amber",
      "title": "Runtime scope",
      "items": [
        "Three long-running containers; migrations and model preparation are one-off tasks.",
        "SQLite and audio use the data volume; model assets use a separate models volume.",
        "This diagram shows the implemented local queued mode, without a public deployment."
      ]
    }
  ]
