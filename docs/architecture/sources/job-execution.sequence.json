      "from": "worker",
      "to": "db",
      "y": 448,
      "label": "Acquire execution grant",
      "variant": "security",
      "note": "No grant means no execution. Load the model only after authorization."
    },
    {
      "id": "step-7",
      "from": "worker",
      "to": "files",
      "y": 540,
      "label": "Read validated WAV",
      "variant": "default"
    },
    {
      "id": "step-8",
      "from": "worker",
      "to": "db",
      "y": 584,
      "label": "Periodic heartbeat",
      "variant": "dashed",
      "note": "Heartbeats run alongside inference; they do not prove completion."
    },
    {
      "id": "step-9",
      "from": "worker",
      "to": "files",
      "y": 676,
      "label": "Save 7 WAVs; manifest last",
      "variant": "emphasis"
    },
    {
      "id": "step-10",
      "from": "worker",
      "to": "dispatcher",
      "y": 720,
      "label": "Report result; child exits",
      "variant": "return",
      "note": "The parent separately confirms that the authorized child and execution group have exited."
    },
    {
      "id": "step-11",
      "from": "dispatcher",
      "to": "db",
      "y": 812,
      "label": "Persist stop proof",
      "variant": "default"
    },
    {
      "id": "step-12",
      "from": "dispatcher",
      "to": "files",
      "y": 856,
      "label": "Verify WAVs, identity, SHA-256",
      "variant": "default"
    },
    {
      "id": "step-13",
      "from": "dispatcher",
      "to": "db",
      "y": 900,
      "label": "Commit outputs + success",
      "variant": "emphasis"
    },
    {
      "id": "step-14",
      "from": "browser",
      "to": "api",
      "y": 944,
      "label": "GET /jobs/{id}",
      "variant": "default"
    },
    {
      "id": "step-15",
      "from": "api",
      "to": "db",
      "y": 988,
      "label": "Check owner; read status",
      "variant": "security"
    },
    {
      "id": "step-16",
      "from": "api",
      "to": "browser",
      "y": 1032,
      "label": "completed + outputs",
      "variant": "return"
    },
    {
      "id": "step-17",
      "from": "browser",
      "to": "api",
      "y": 1076,
      "label": "Request track + Bearer",
      "variant": "default"
    },
    {
      "id": "step-18",
      "from": "api",
      "to": "db",
      "y": 1120,
      "label": "Recheck ownership",
      "variant": "security"
