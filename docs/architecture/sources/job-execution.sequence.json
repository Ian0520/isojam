      "label": "Reserve; mark submitting",
      "variant": "default",
      "note": "Reserve the attempt and mark submitting in separate short transactions, before starting the worker."
    },
    {
      "id": "step-5",
      "from": "dispatcher",
      "to": "worker",
      "y": 404,
      "label": "Start model child",
      "variant": "emphasis"
