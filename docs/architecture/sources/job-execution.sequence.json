      "from": "api",
      "to": "browser",
      "y": 1208,
      "label": "Return WAV",
      "variant": "return"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Scope of this sequence",
      "items": [
        "The starting upload_id is already validated and belongs to the user.",
        "This is the successful path. Vertical position means order, not measured duration.",
        "Authorization, heartbeats, exit confirmation and publication are separate operations."
      ]
    },
    {
      "dot": "emerald",
      "title": "Retries and transactions",
      "items": [
        "After a lost response, the same user, key and request return the original job.",
        "Job + receipt creation and outputs + attempt/job success each commit atomically.",
        "Inference, file reads and verification do not hold database write transactions."
      ]
    },
    {
      "dot": "amber",
      "title": "Recovery boundaries",
      "items": [
        "A valid bundle and confirmed exit allow publication recovery without inference.",
        "Missing exit proof or damaged results require inspection, not automatic re-execution.",
        "Every status request and download rechecks identity and ownership."
      ]
    }
  ]
