# Copy to /etc/isojam/runtime.env on the host. Never commit the populated file.
# Generate the JWT secret once; keep it stable across container replacements.
ISOJAM_JWT_SECRET_KEY=
ISOJAM_REGISTRATION_MODE=closed
ISOJAM_PORT=8000
ISOJAM_MAX_UNFINISHED_JOBS_PER_USER=1
ISOJAM_MAX_UNFINISHED_IMPORTS_PER_USER=1
ISOJAM_MAX_UNFINISHED_IMPORTS=2
